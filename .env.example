# Environment variables (for future backend integration)

# API Configuration (add when connecting backend)
# NEXT_PUBLIC_API_URL=http://localhost:3001
# API_SECRET_KEY=your_secret_key_here

# Database (when using Supabase, Neon, etc.)
# DATABASE_URL=postgresql://user:password@host:port/database
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_key

# Authentication (when using Auth0, NextAuth, etc.)
# NEXTAUTH_SECRET=your_secret_here
# NEXTAUTH_URL=http://localhost:3000

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=your_google_analytics_id
# SENTRY_DSN=your_sentry_dsn

# File Storage (Vercel Blob or similar)
# BLOB_READ_WRITE_TOKEN=your_token_here

# Email Service (for notifications)
# SENDGRID_API_KEY=your_sendgrid_key
# SMTP_FROM=noreply@wellnest.app

# Feature Flags
# NEXT_PUBLIC_ENABLE_SOCIAL_FEATURES=true
# NEXT_PUBLIC_ENABLE_PREMIUM=false
